# PyConnectedness matplotlib style
#
# Drop-in rcParams for the library's existing plotting functions. Covers what's validated and
# portable: colour, type, line weight, grid. Does NOT change layout (circular network, matrix
# heatmap) -- see STYLE_GUIDE.md "What's not here, on purpose".
#
# Usage:
#   import matplotlib.pyplot as plt
#   plt.style.use("pyconnectedness.mplstyle")
#
# Typography needs the fonts registered first (they aren't matplotlib built-ins) -- see
# STYLE_GUIDE.md "Registering the fonts". Words are Plus Jakarta Sans, as in the web explorer;
# numbers are B612 Mono via pcstyle.mono_numbers(ax), since no rcParam targets tick labels alone.

figure.facecolor: fcfcfb
axes.facecolor: fcfcfb
savefig.facecolor: fcfcfb

axes.edgecolor: c3c2b7
axes.linewidth: 0.8
axes.grid: True
grid.color: e1e0d9
grid.linewidth: 0.8
grid.alpha: 1.0

axes.labelcolor: 52514e
text.color: 0b0b0b
xtick.color: 898781
ytick.color: 898781
xtick.labelsize: 10
ytick.labelsize: 10

font.family: sans-serif
font.sans-serif: Plus Jakarta Sans, DejaVu Sans, sans-serif
axes.titlesize: 13
axes.titleweight: 600
axes.titlelocation: left
axes.labelsize: 10.5

lines.linewidth: 2.0
lines.solid_capstyle: round
lines.solid_joinstyle: round

axes.prop_cycle: cycler('color', ['2a78d6', 'e34948'])

legend.frameon: False
legend.fontsize: 10

axes.spines.top: False
axes.spines.right: False
